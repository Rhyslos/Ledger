{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for every Ledger window",
  "windows": ["main", "win-*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "dialog:default",
    "opener:default"
  ]
}
