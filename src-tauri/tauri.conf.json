{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ledger",
  "version": "0.1.0",
  "identifier": "dev.rhy.ledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ledger",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 400,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "icons/lst.ico": "lst.ico",
      "icons/lsc.ico": "lsc.ico",
      "icons/lql.ico": "lql.ico"
    },
    "fileAssociations": [
      {
        "ext": [
          "lst",
          "lust"
        ],
        "name": "Lust.Program",
        "description": "Lust program",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "lsc"
        ],
        "name": "Lust.Script",
        "description": "LustScript file",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "lql"
        ],
        "name": "Lust.Query",
        "description": "LustQL file",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ]
  },
  "mainBinaryName": "Ledger",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDM0Q2MDBGQkVGMzRDQjQKUldTMFRQTytEMkE5dlB5VnFXVldhdGpwWTBIdjNwQnl4QmQ3eGJ6SzVHRmJLaFgwb1ZNcVlFWHoK",
      "endpoints": [
        "https://github.com/Rhyslos/Ledger/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
